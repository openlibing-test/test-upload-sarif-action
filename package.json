{
  "name": "openlibing-upload-sarif",
  "version": "1.0.2",
  "description": "将任意工具产出的 SARIF 扫描结果上传到 OpenLibing（OIDC 认证）",
  "main": "index.js",
  "scripts": {
    "package": "ncc build index.js -o dist",
    "zip": "node zip.js",
    "build": "npm run package && npm run zip",
    "test": "c8 --reporter=text --reporter=json --reporter=cobertura node --test"
  },
  "author": "test-devops",
  "license": "ISC",
  "dependencies": {
    "@openlibing/huaweicloud-oidc-client": "0.0.5",
    "esdk-obs-nodejs": "^3.26.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.10.0",
    "@microsoft/eslint-formatter-sarif": "3.1.0",
    "@vercel/ncc": "^0.38.1",
    "adm-zip": "^0.5.16",
    "c8": "^10.1.3",
    "eslint": "^9.10.0",
    "globals": "^16.5.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.1.0"
  }
}
